#!/usr/bin/env bash
# Launcher for docdicer: on first use it builds a venv beside this script and installs the pinned
# docdicer there, sending install output to stderr.

VERSION=0.11.0
PACKAGE="git+https://github.com/benn-herrera/docdicer@v${VERSION}"

case "${0}" in
  */*) dir="${0%/*}" ;;
  *) dir="." ;;
esac

venv=${dir}/.venv
venv_bin=${venv}/bin
venv_python=${venv_bin}/python
venv_docdicer=${venv_bin}/docdicer

function remedy() {
  {
    printf 'docdicer needs python3 3.9 or later with its venv module.\n'
    case "$(uname)" in
      Darwin) printf '  brew install python (or: xcode-select --install)\n';;
      Linux) printf '  use your package manager to install python3 and, if split out, python3-venv\n';;
      *) printf '  install python3 via pyenv or from python.org\n';;
    esac
  } >&2
  exit 1
}

{ [[ -x "${venv_python}" ]]  && "${venv_python}" -c '' 2> /dev/null; } || {
  command rm -rf "${venv}" && \
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null && \
  python3 -m venv --upgrade-deps "${venv}"
} >&2 || { command rm -rf "${venv}"; remedy; }
[[ -x "${venv_docdicer}" && "$("${venv_docdicer}" --version)" == "${VERSION}" ]] || \
  "${venv_python}" -m pip install "${PACKAGE}" >&2 || exit 1

exec "${venv_docdicer}" "${@}"
