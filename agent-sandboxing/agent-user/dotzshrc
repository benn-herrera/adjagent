# insert your favorite aliases here.

# defined in .zshenv, self-undefines
setup-env

function init-comp() {
  autoload -Uz compinit
  compinit -u -d "${HOME}/.zcompdump"
  unset -f init-comp
}

init-comp
# use CWD passed from privileged user's invocation of 'au' (su to agent-user)
[[ -d "${AU_DIR}" ]] && { cd "${AU_DIR}"; unset AU_DIR; } || true
